{
  "manifest_version": 3,
  "name": "AI Batch Studio",
  "version": "1.0.0",
  "description": "Batch AI image and video generation for ChatGPT and Google Flow with reference management and automatic downloads.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AI Batch Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "notifications",
    "tabs",
    "scripting",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://flow.google/*",
    "https://*.flow.google/*",
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://aitestkitchen.withgoogle.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://flow.google/*",
        "https://*.flow.google/*",
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/*",
        "https://*.labs.google/*",
        "https://aitestkitchen.withgoogle.com/*"
      ],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
